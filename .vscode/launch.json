{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Attach to Brave (Ignore Extensions)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}",
      "urlFilter": "http://127.0.0.1:8061/*",

      "skipFiles": [
        "**/node_modules/**",
        "**/extensions/**",
        "**/chrome-extension://*/**",
        "**/brave-extension://*/**"
      ],

      "sourceMapPathOverrides": {
        "webpack:///./*": "${webRoot}/*"
      }
    }
  ]
}
